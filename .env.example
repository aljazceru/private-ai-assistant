# Signal configuration
SIGNAL_PHONE_NUMBER=+1234356

# PrivateMode API configuration
PRIVATEMODE_BASE_URL=http://localhost:8080
# Optional: Model to use (if not specified, will use first available model)
# PRIVATEMODE_MODEL=ibnzterrell/Meta-Llama-3.3-70B-Instruct-AWQ-INT4

# Permission System Configuration
# Path to permissions configuration file (default: permissions.json)
# PERMISSIONS_CONFIG_PATH=permissions.json

# Signal Service Configuration
# Signal CLI REST API service endpoint (default: localhost:8080)
# SIGNAL_SERVICE=localhost:8080

# Security Configuration
# Enable/disable permission system (default: enabled)
# PERMISSIONS_ENABLED=true

# Logging Configuration
# Log level for permission system (default: INFO)
# PERMISSIONS_LOG_LEVEL=INFO

# Admin Configuration
# Default admin phone number for initial setup
# Set this to your phone number to get admin access on first run
# ADMIN_PHONE_NUMBER=+1234567890

# STT Configuration - Choose your preferred STT system
# Set to "sherpa" for local Sherpa-ONNX processing
# Set to "whisper" for external Whisper API
# Set to "auto" (default) to try Sherpa first, fallback to Whisper
STT_PREFERRED_SYSTEM=auto

# Sherpa-ONNX Configuration (Local STT/TTS)
# Set to "false" to use original Whisper/Kokoro HTTP APIs
USE_SHERPA_STT=true
USE_SHERPA_TTS=true

# Sherpa-ONNX Models Configuration
# Root directory containing sherpa-onnx models
SHERPA_MODELS_ROOT=./models

# STT (Speech-to-Text) Configuration
# Available models: sensevoice, zipformer-bilingual, paraformer-trilingual, paraformer-en, fireredasr
SHERPA_ASR_MODEL=sensevoice
# Language for ASR: zh, en, ja, ko, yue (model dependent)
SHERPA_ASR_LANGUAGE=zh
# ONNX Runtime provider: cpu, cuda (if available)
SHERPA_PROVIDER=cpu
# Number of processing threads
SHERPA_THREADS=2

# TTS (Text-to-Speech) Configuration
# Available models: vits-zh-hf-theresa, vits-melo-tts-zh_en, kokoro-multi-lang-v1_0
SHERPA_TTS_MODEL=vits-zh-hf-theresa
# Speaker ID (0 for single-speaker models, 0-52 for kokoro-multi-lang)
SHERPA_SPEAKER_ID=0
# Speech speed (1.0 = normal, >1.0 = faster, <1.0 = slower)
SHERPA_SPEED=1.0

# Legacy Whisper ASR Configuration (Fallback if Sherpa-ONNX not available)
# Comma-separated list of Whisper ASR instance URLs (supports failover)
# Examples for different setups:
#   - Host machine: http://localhost:9000,http://localhost:9001
#   - Docker container (bridge network): http://172.17.0.1:9000
#   - Docker container (host network): http://localhost:9000
#   - External server: http://whisper.example.com:9000
# Multiple instances for failover: http://localhost:9000,http://localhost:9001,http://backup-whisper:9000
# WHISPER_ASR_URLS=http://localhost:9000
# Optional: Whisper output format (text, json, vtt, srt, tsv)
# WHISPER_OUTPUT_FORMAT=text
# Optional: Enable voice activity detection filter
# WHISPER_VAD_FILTER=true
# Optional: Language for transcription (auto-detect if not specified)
# WHISPER_LANGUAGE=en

# Voice Activation Configuration
# Phrase that triggers AI chat from voice messages (default: "hey jarvis")
# Examples: "hey computer", "assistant", "ai", "bot"
VOICE_ACTIVATION_PHRASE=hey jarvis

# Storage Configuration
# Storage type: sqlite (default), redis, in-memory
STORAGE_TYPE=sqlite
# SQLite database path (when using sqlite storage)
STORAGE_DB_PATH=/app/data/bot.db

# Legacy Kokoro TTS Configuration (Fallback if Sherpa-ONNX not available)
# Comma-separated list of Kokoro TTS service URLs
# Example: http://localhost:8880,http://tts-server:8880
# KOKORO_TTS_URLS=http://localhost:8880
# Voice for TTS synthesis (can combine voices with +)
# Examples: "af_bella", "af_sky", "af_bella+af_sky"
# KOKORO_TTS_VOICE=af_bella
# Audio output format (mp3, wav, opus, flac, m4a, pcm)
# KOKORO_TTS_FORMAT=mp3
